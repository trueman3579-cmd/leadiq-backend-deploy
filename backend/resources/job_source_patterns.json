{
  "sources": {
    "indeed": {
      "fetch_mode": "stealth",
      "base_url": "https://in.indeed.com",
      "search_path": "/jobs",
      "not_found_indicators": ["no results", "no jobs found", "we couldn't find any"],
      "apply_patterns": ["apply now", "apply", "easy apply"],
      "expired_patterns": ["job is no longer available", "position has been filled", "this job has expired"],
      "rate_limit_codes": [429],
      "job_id_format": "alphanumeric"
    },
